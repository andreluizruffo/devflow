# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL (used by the API, Prisma and docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/devflow
DATABASE_URL_TEST=postgresql://postgres:change-me@localhost:5432/devflow_test

# API
PORT=3333

# Auth — use a long random string (at least 32 characters) for the secret
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
